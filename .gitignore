# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# Data & artifacts (never commit generated or proprietary data)
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
*.parquet
*.duckdb
*.db
*.sqlite
artifacts/*
!artifacts/.gitkeep
reports/*
!reports/.gitkeep
mlruns/
paper_state/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.idea/
.vscode/
